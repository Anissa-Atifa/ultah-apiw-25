# ============================================================================
# KONFIGURASI SUPABASE & PIN RAHASIA (Copy ke Environment Variables di Vercel)
# ============================================================================

# 1. URL Project Supabase Anda (Dari menu Project Settings -> API di Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Anon Public Key Supabase Anda (Dari menu Project Settings -> API di Supabase)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 3. PIN Rahasia Pasangan (Default: 250325 sesuai tanggal jadian 25 Maret 2025)
ADMIN_SECRET_PIN=250325
